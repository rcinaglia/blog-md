node_modules
.output
.git

# NOTE: .gitignore is deliberately NOT ignored here. Tailwind's automatic
# source detection reads it to decide what to skip, so leaving it out of
# the image makes the in-container build scan different files than a local
# build does (see the @source rule in src/styles.css).
Dockerfile
docker-compose.yaml
.dockerignore

# Content is bind-mounted at runtime (see docker-compose.yaml), no need
# to ship it inside the image.
content

# Env files are bind-mounted at runtime, not baked into the image.
.env
.env.local
*.local

.vscode
README.md
AGENTS.md
